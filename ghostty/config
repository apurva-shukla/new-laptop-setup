working-directory = /Users/apurvashukla/code/sumble
window-inherit-working-directory = false

# --- Multiplexer ---
# Herdr is the outer multiplexer, replacing the previous
# `tmux new-session -A -s main`. Its keybindings in
# new-laptop-setup/herdr/config.toml mirror the tmux vocabulary:
# prefix Ctrl+Space, `-` / `|` to split, `c` for a new tab, IJKL to
# move between panes. Herdr keeps a persistent background server, so
# closing this window leaves pane processes running and the next
# window re-attaches.
#
# tmux is still installed and ~/.tmux.conf is untouched. For a plain
# shell or a tmux window that bypasses Herdr:
#   open -na Ghostty --args -e /bin/zsh -l
#   open -na Ghostty --args -e /opt/homebrew/bin/tmux new-session -A -s main
command = /opt/homebrew/bin/herdr
# --- Visuals & Theme ---
# "catppuccin-mocha" is a very popular, high-contrast pastel dark theme
theme = catppuccin-mocha

# CommitMono — neutral, anonymous programming typeface
font-family = "CommitMono"
font-family-bold = "CommitMono"
font-family-italic = "CommitMono"
font-family-bold-italic = "CommitMono"
font-size = 14
# Enable ligatures (makes arrows like => look like one symbol)
font-feature = +calt

# --- Window Aesthetics (The "Glass" Look) ---
# Slight transparency with blur looks very native on macOS
background-opacity = 0.90
background-blur-radius = 20
unfocused-split-opacity = 0.85

# Add breathing room between the window edge and the text
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# --- Minimalist UI (Yabai Style) ---
# Hides the macOS title bar (stoplights). 
# Since you use Yabai, you don't need the title bar taking up space.
macos-titlebar-style = transparent

# --- Cursor ---
cursor-style = block
cursor-style-blink = true
shell-integration-features = cursor

# --- Mouse ---
# Hides mouse when you start typing so it doesn't block code
mouse-hide-while-typing = true

# --- macOS Muscle Memory ---
keybind = cmd+right=text:\x05
keybind = cmd+left=text:\x01
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = cmd+backspace=text:\x15
# This one makes Cmd+Delete (Forward delete) clear to end of line
keybind = cmd+delete=text:\x0b
# This one makes Option+Backspace delete the word to the left
keybind = alt+backspace=text:\x17
keybind = shift+enter=text:\x1b\r
