#!/bin/sh

# Load scripting addition (requires SIP partially disabled)
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Reserve space for SketchyBar (height + margin + padding)
yabai -m config external_bar all:45:0

# Use BSP tiling layout
yabai -m config layout bsp

# Label spaces
yabai -m space 1 --label chrome
yabai -m space 2 --label slack
yabai -m space 3 --label flex1
yabai -m space 4 --label flex2
yabai -m space 5 --label zen
yabai -m space 6 --label messaging

# Disable apps from being managed by yabai (floating)
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Reminders$" manage=off
yabai -m rule --add app="^Raycast$" title!="^AI Chat$" manage=off
yabai -m rule --add app="^Loom$" manage=off
yabai -m rule --add app="^Screenstudio$" manage=off
yabai -m rule --add app="^BetterTouchTool$" manage=off
yabai -m rule --add app="^BTT$" manage=off
yabai -m rule --add app="^Shottr$" manage=off
yabai -m rule --add app="^Shottr.cc$" manage=off
yabai -m rule --add app="^VoiceInk$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Dropover$" manage=off
yabai -m rule --add title="[Bb]itwarden" manage=off

yabai -m config window_placement second_child

# Keep focused window on top (raise on focus, lower on unfocus)
yabai -m signal --add event=window_focused action="yabai -m window \$YABAI_WINDOW_ID --sub-layer above"
yabai -m signal --add event=window_unfocused action="yabai -m window \$YABAI_WINDOW_ID --sub-layer normal"

# Rebalance the tree when windows change
yabai -m signal --add event=window_created  action="yabai -m space --balance"
yabai -m signal --add event=window_destroyed action="yabai -m space --balance"

# Send apps to specific spaces and focus that space
# Space 1 - Chrome
yabai -m rule --add app="^Google Chrome$" space=1
yabai -m signal --add event=window_created app="^Google Chrome$" action="yabai -m space --focus 1"

# Space 2 - Slack
yabai -m rule --add app="^Slack$" space=2
yabai -m signal --add event=window_created app="^Slack$" action="yabai -m space --focus 2"

# Space 3 & 4 - Flex (no rules, open anything here)

# Space 5 - Zen
yabai -m rule --add app="^(Zen|Zen Browser)$" space=5
yabai -m signal --add event=window_created app="^(Zen|Zen Browser)$" action="yabai -m space --focus 5"

# Space 6 - Messaging
yabai -m rule --add app="WhatsApp$" space=6
yabai -m rule --add app="^Messages$" space=6
yabai -m signal --add event=window_created app="WhatsApp$" action="yabai -m space --focus 6"
yabai -m signal --add event=window_created app="^Messages$" action="yabai -m space --focus 6"
 
# Padding and gaps
yabai -m config top_padding    0
yabai -m config bottom_padding 4
yabai -m config left_padding   4
yabai -m config right_padding  4
yabai -m config window_gap     4

# Mouse modifier (hold fn + drag to move/resize)
yabai -m config mouse_modifier fn
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

pkill -x borders 2>/dev/null || true
borders active_color=0xff00ff00 inactive_color=0x00000000 width=6.0 style=round &
