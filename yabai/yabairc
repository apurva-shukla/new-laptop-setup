#!/bin/sh

JQ_BIN="$(command -v jq || true)"

reset_signals() {
  [ -n "$JQ_BIN" ] || return 0

  yabai -m signal --list 2>/dev/null \
    | "$JQ_BIN" -r 'sort_by(.index) | reverse | .[].index' \
    | while IFS= read -r signal_index; do
        [ -n "$signal_index" ] || continue
        yabai -m signal --remove "$signal_index" 2>/dev/null || true
      done
}

reset_rules() {
  [ -n "$JQ_BIN" ] || return 0

  yabai -m rule --list 2>/dev/null \
    | "$JQ_BIN" -r 'sort_by(.index) | reverse | .[].index' \
    | while IFS= read -r rule_index; do
        [ -n "$rule_index" ] || continue
        yabai -m rule --remove "$rule_index" 2>/dev/null || true
      done
}

add_signal() {
  label="$1"
  event="$2"
  action="$3"
  shift 3

  yabai -m signal --remove "$label" 2>/dev/null || true
  yabai -m signal --add event="$event" action="$action" label="$label" "$@"
}

# Load scripting addition (requires SIP partially disabled)
reset_signals
reset_rules
add_signal dock_did_restart dock_did_restart "sudo yabai --load-sa"
sudo yabai --load-sa

# SketchyBar is disabled, so yabai should not reserve bar space or notify it.
SKETCHYBAR_BIN=""
yabai -m config external_bar all:0:0

# Use BSP tiling layout
yabai -m config layout bsp

# Label spaces
yabai -m space 1 --label chrome
yabai -m space 2 --label slack
yabai -m space 3 --label flex1
yabai -m space 4 --label flex2
yabai -m space 5 --label zen
yabai -m space 6 --label messaging

# Disable apps from being managed by yabai (floating)
yabai -m rule --add app="^System Settings$" manage=off
# yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Reminders$" manage=off
yabai -m rule --add app="^Raycast$" title!="^AI Chat$" manage=off
yabai -m rule --add app="^Loom$" manage=off
yabai -m rule --add app="^Screenstudio$" manage=off
yabai -m rule --add app="^BetterTouchTool$" manage=off
yabai -m rule --add app="^BTT$" manage=off
yabai -m rule --add app="^Shottr$" manage=off
yabai -m rule --add app="^Shottr.cc$" manage=off
yabai -m rule --add app="^VoiceInk$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Dropover$" manage=off
yabai -m rule --add title="[Bb]itwarden" manage=off

yabai -m config window_placement second_child
yabai -m config auto_balance on
yabai -m config window_animation_duration 0.0
yabai -m config window_opacity_duration 0.0

# Send apps to specific spaces and focus that space
# Space 1 - Chrome
yabai -m rule --add app="^Google Chrome$" space=chrome
add_signal focus_space_chrome window_created "yabai -m space --focus chrome" app="^Google Chrome$"

# Space 2 - Slack
yabai -m rule --add app="^Slack$" space=slack
add_signal focus_space_slack window_created "yabai -m space --focus slack" app="^Slack$"

# Space 3 & 4 - Flex (no rules, open anything here)

# Space 5 - Zen
yabai -m rule --add app="^(Zen|Zen Browser)$" space=zen
add_signal focus_space_zen window_created "yabai -m space --focus zen" app="^(Zen|Zen Browser)$"

# Space 6 - Messaging
yabai -m rule --add app="WhatsApp$" space=messaging
yabai -m rule --add app="^Messages$" space=messaging
add_signal focus_space_whatsapp window_created "yabai -m space --focus messaging" app="WhatsApp$"
add_signal focus_space_messages window_created "yabai -m space --focus messaging" app="^Messages$"

# Padding and gaps
# Let tiled windows sit directly below the native macOS menu bar.
yabai -m config top_padding    0
yabai -m config bottom_padding 4
yabai -m config left_padding   4
yabai -m config right_padding  4
yabai -m config window_gap     4

# Mouse modifier (hold fn + drag to move/resize)
yabai -m config mouse_modifier fn
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize


pkill -x borders 2>/dev/null || true
borders active_color=0xff00ff00 inactive_color=0x00000000 width=6.0 style=round &
