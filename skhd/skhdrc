# Notification helper for lower-frequency bindings that still benefit from feedback
# Usage: notify.sh "Title" "Body" cmd [args...]

# Hot-path navigation bindings bypass notifications/logging for lower latency.

# moves focus between windows in the current focused display
alt - j : yabai -m window --focus west
alt - k : yabai -m window --focus south
alt - i : yabai -m window --focus north
alt - l : yabai -m window --focus east

# toggle window split type
alt - s : yabai -m window --toggle split

# toggle skip-empty-spaces mode (ctrl+left/right behavior)
alt - y : _L="$HOME/.local/share/skhd/usage.log"; mkdir -p "$(dirname "$_L")"; \
          if [ -f /tmp/skhd_skip_empty_spaces ]; then \
            rm -f /tmp/skhd_skip_empty_spaces; \
            printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "Space Skip" "OFF" >> "$_L"; \
            osascript -e 'display notification "Visiting ALL spaces" with title "Space Skip: OFF"'; \
          else \
            touch /tmp/skhd_skip_empty_spaces; \
            printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "Space Skip" "ON" >> "$_L"; \
            osascript -e 'display notification "Skipping empty spaces" with title "Space Skip: ON"'; \
          fi

# rotate tree
alt - r : ~/.config/skhd/notify.sh "Layout" "Rotated 90°" yabai -m space --rotate 90

# mirror tree y-axis
alt - m : ~/.config/skhd/notify.sh "Layout" "Mirrored Y-axis" yabai -m space --mirror y-axis

# float / unfloat window and center on screen
# alt - t disabled: no manual float toggle
# alt - t : ~/.config/skhd/notify.sh "Float" "Toggled float" bash -c 'yabai -m window --toggle float; if [ "$(yabai -m query --windows --window | jq -r ".\"is-floating\"")" = "true" ]; then yabai -m window --sub-layer normal; yabai -m window --grid 4:4:1:1:2:2; else yabai -m window --sub-layer normal; fi'
shift + alt - t : bash ~/.config/skhd/park_window.sh
ctrl + alt - t : bash ~/.config/skhd/raise_floating_window.sh

# swap window
shift + alt - j : yabai -m window --swap west
shift + alt - k : yabai -m window --swap south
shift + alt - i : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# move window
shift + cmd - j : yabai -m window --warp west
shift + cmd - k : yabai -m window --warp south
shift + cmd - i : yabai -m window --warp north
shift + cmd - l : yabai -m window --warp east

# change layout of desktop
alt - b : ~/.config/skhd/notify.sh "Layout" "BSP tiling" yabai -m space --layout bsp
alt - f : ~/.config/skhd/notify.sh "Layout" "Floating" yabai -m space --layout float

# increase window size
ctrl + alt - j : yabai -m window --resize left:-40:0
ctrl + alt - k : yabai -m window --resize bottom:0:40
ctrl + alt - i : yabai -m window --resize top:0:-40
ctrl + alt - l : yabai -m window --resize right:40:0

# decrease window size
ctrl + alt + cmd - l : yabai -m window --resize left:40:0
ctrl + alt + cmd - i : yabai -m window --resize bottom:0:-40
ctrl + alt + cmd - k : yabai -m window --resize top:0:40
ctrl + alt + cmd - j : yabai -m window --resize right:-40:0

# restart yabai
ctrl + alt + cmd - r : ~/.config/skhd/notify.sh "yabai" "Restarting…" launchctl kickstart -k "gui/${UID}/com.koekeishiya.yabai"

# switch to space by Mission Control index
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6

# switch to prev/next occupied space (Ctrl + arrows) - skips empty spaces
ctrl - left : ~/.config/skhd/focus_prev_occupied.sh
ctrl - right : ~/.config/skhd/focus_next_occupied.sh
alt - o : ~/.config/skhd/space_overview.sh
shift + alt - o : ~/.config/skhd/move_to_next_free_space.sh

# move window to space by Mission Control index and follow
shift + cmd - 1 : yabai -m window --space 1 --focus
shift + cmd - 2 : yabai -m window --space 2 --focus
shift + cmd - 3 : yabai -m window --space 3 --focus
shift + cmd - 4 : yabai -m window --space 4 --focus
shift + cmd - 5 : yabai -m window --space 5 --focus
shift + cmd - 6 : yabai -m window --space 6 --focus
